# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/eldercare?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Google Gemini AI ─────────────────────────────────
# Get free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# ─── CORS ─────────────────────────────────────────────
# Your deployed frontend URL (Vercel). Comma-separate multiple origins.
# Example: https://elder-care.vercel.app,https://www.mysite.com
CLIENT_URL=https://your-frontend.vercel.app
